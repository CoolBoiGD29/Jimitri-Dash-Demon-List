rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone using the site (even anonymously) can read/write.
    // This app's admin/ban/mod checks happen in app.js, not here — see the
    // README's security note for what that does and doesn't protect against.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
